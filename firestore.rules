rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasAll(['uid', 'email', 'name', 'role', 'createdAt'])
          && d.keys().hasOnly(['uid', 'email', 'name', 'role', 'createdAt', 'cnpj'])
          && d.uid == userId
          && d.email is string && d.email == request.auth.token.email
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
          && d.role in ['candidate', 'company']
          && d.createdAt == request.time
          && ((d.role == 'candidate' && !('cnpj' in d))
            || (d.role == 'company' && d.cnpj is string
              && d.cnpj.size() > 0 && d.cnpj.size() <= 32));
      }
      allow get: if owner();
      allow create: if owner() && validProfile();
      // Editing/deletion are not part of this release. Roles cannot be changed.
      allow list, update, delete: if false;
    }
    // Add specific rules when vacancies/applications are connected later.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
