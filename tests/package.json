{
  "private": true,
  "description": "Testes locais das regras do Avance+; n\u00e3o s\u00e3o depend\u00eancias do app Flutter.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-avance-catalog --config ../firebase.emulator.json \"node run_all.cjs\"",
