rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}/avatar {
      function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
      allow read, delete: if owner();
      allow create, update: if owner()
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
